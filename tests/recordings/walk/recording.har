            "text": "{\"data\":[{\"slug\":\"midpage\",\"name\":\"Midpage Legal Research\",\"icon_url\":\"https://integrations.sh/logo/midpage.ai\",\"description\":\"Connect Claude to a database of case law. With the Midpage MCP, Claude can conduct complex legal research, review opinions, and craft high quality work product. Everything is hyperlinked to real sources for easy verification.\",\"auth_type\":null,\"mcp_url\":\"https://app.midpage.ai/mcp\",\"docs_url\":\"https://docs.midpage.ai/documentation/integration/mcp-tools\"},{\"slug\":\"craft\",\"name\":\"Craft\",\"icon_url\":\"https://integrations.sh/logo/craft.do\",\"description\":\"Create beautifully structured documents, manage tasks, and build a personal knowledge base - all directly from Claude. Give Claude a persistent workspace to save research, draft content, track to-dos, and organize everything into folders, s\",\"auth_type\":null,\"mcp_url\":\"https://mcp.craft.do/my/mcp\",\"docs_url\":\"https://www.craft.do/imagine/guide/mcp/mcp\"},{\"slug\":\"contentsquare\",\"name\":\"Contentsquare\",\"icon_url\":\"https://integrations.sh/logo/contentsquare.com\",\"description\":\"Quickly understand everything your users are doing and why, directly from Claude. Contentsquare automatically captures every user action and analyzes it retroactively, no tagging needed. Ask Claude natural language questions about your anal\",\"auth_type\":null,\"mcp_url\":\"https://api.contentsquare.com/mcp\",\"docs_url\":\"https://support.contentsquare.com/hc/en-us/articles/41563169756945-How-to-set-up-and-use-Model-Context-Protocol-MCP\"},{\"slug\":\"3min-api\",\"name\":\"3Min API\",\"icon_url\":\"https://integrations.sh/logo/3minapi.com\",\"description\":\"3Min API lets you create REST APIs without writing backend code. Define a JSON schema, and get full CRUD endpoints with automatic webhook delivery, sandbox/production separation, real-time logs, and usage statistics. Manage everything throu\",\"auth_type\":null,\"mcp_url\":\"https://3minapi.com/api/mcp\",\"docs_url\":\"https://3minapi.com/docs/mcp\"},{\"slug\":\"angi\",\"name\":\"Angi\",\"icon_url\":\"https://integrations.sh/logo/angi.com\",\"description\":\"Find a skilled professional for all your home improvement needs with Angi. Angi gives you access to a nationwide network of home service professionals, with 30 years of experience in everything from remodeling and landscaping to cleaning an\",\"auth_type\":null,\"mcp_url\":\"https://api.angi.com/v1/mcp\",\"docs_url\":\"https://www.angi.com/\"}]}"
