            "text": "{\"trace_id\":\"6361bc17e58bd338bacfde785ef9a803\",\"span_id\":\"c40b144048490ba5\",\"parent_span_id\":\"72588b321ab763d3\",\"name\":\"chat scripted-llm\",\"kind\":\"UNSPECIFIED\",\"start_time\":\"2026-10-28T09:58:27.995000Z\",\"duration_ns\":3350836,\"status\":{\"code\":\"Unset\"},\"resource\":{\"service\":{\"name\":\"hello-mcp\"}},\"attributes\":{\"gen_ai\":{\"agent\":{\"id\":\"scripted:01a181f1-9ef6-7000-8a61-2af1d6d7f71d\",\"name\":\"scripted\",\"version\":\"543b8db50a839029b03d7ca7957884d806df646c\"},\"conversation\":{\"id\":\"01a181f2-5097-73ba-a82e-c63f50153730\"},\"operation\":{\"name\":\"chat\"},\"provider\":{\"name\":\"introspection\"},\"request\":{\"model\":\"scripted-llm\",\"stream\":true},\"response\":{\"finish_reasons\":[\"aborted\"],\"model\":\"scripted-llm\"},\"usage\":{\"input_tokens\":0,\"output_tokens\":0,\"cache_read\":{\"input_tokens\":0},\"cache_creation\":{\"input_tokens\":0}},\"tool\":{\"definitions\":[{\"name\":\"read\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"parameters\":{\"properties\":{\"limit\":{\"description\":\"Maximum number of lines to read\",\"type\":\"number\"},\"offset\":{\"description\":\"Line number to start reading from (1-indexed)\",\"type\":\"number\"},\"path\":{\"description\":\"Path to the file to read (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\",\"parameters\":{\"properties\":{\"command\":{\"description\":\"Shell command to execute\",\"type\":\"string\"},\"timeout\":{\"description\":\"Timeout in seconds (optional, no default timeout)\",\"type\":\"number\"}},\"required\":[\"command\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"write\",\"description\":\"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.\",\"parameters\":{\"properties\":{\"content\":{\"description\":\"Content to write to the file\",\"type\":\"string\"},\"path\":{\"description\":\"Path to the file to write (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\",\"content\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"mcp_hello-mcp_echo_921a5a7771\",\"description\":\"Echoes back the input\",\"parameters\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"message\":{\"description\":\"Message to echo\",\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"},\"type\":\"function\"}]},\"output\":{\"messages\":[{\"role\":\"assistant\",\"finish_reason\":\"aborted\",\"provider\":\"introspection\",\"model\":\"scripted-llm\",\"api\":\"openai-completions\"}]}},\"introspection\":{\"agent\":{\"depth\":\"0\",\"kind\":\"session\"},\"byok\":false,\"environment\":\"production\",\"ingest\":{\"host\":\"d0bcc8be2e05\",\"time\":1793181508004373},\"member\":{\"id\":\"01a181f0-2e11-710c-8873-915d8c04c713\"},\"org\":{\"id\":\"01a181f0-2e03-7030-8f79-1c82b6e896f4\"},\"project\":{\"id\":\"01a181f1-916b-75fe-8346-58cac96f5b91\"},\"recipe\":{\"git_commit_sha\":\"543b8db50a839029b03d7ca7957884d806df646c\"},\"run\":{\"id\":\"01a181f2-6160-7089-b828-8ca3c732744c\",\"root_id\":\"01a181f2-5097-73ba-a82e-c63e295177d3\"},\"runtime\":{\"group_id\":\"01a181f1-9ef6-7000-8a61-2af1d6d7f71d\",\"id\":\"01a181f2-2587-70a6-9bae-7c7fca23db79\"},\"task\":{\"id\":\"01a181f2-5097-73ba-a82e-c63f50153730\",\"run_id\":\"01a181f2-616