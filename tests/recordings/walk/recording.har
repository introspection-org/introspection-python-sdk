            "text": "{\"object\":\"list\",\"first_id\":\"4c5daf9393f01b77\",\"data\":[{\"trace_id\":\"e392a99f0a176c93e1faf01064324b1f\",\"span_id\":\"4c5daf9393f01b77\",\"parent_span_id\":\"8c420418a0274a2e\",\"name\":\"chat scripted-llm\",\"kind\":\"UNSPECIFIED\",\"start_time\":\"2026-11-05T03:12:09.918000Z\",\"duration_ns\":9567482,\"status\":{\"code\":\"Unset\"},\"resource\":{\"introspection\":{\"environment\":\"production\",\"recipe\":{\"git_commit_sha\":\"f12cffb97ee8e0416f18570ff57f02e13beb6dbf\"},\"runtime\":{\"group_id\":\"01a1a9b0-a441-7009-a8cb-b7a2be5f4ef9\",\"id\":\"01a1a9b1-064f-711d-96d1-ac85f95303b5\"}},\"service\":{\"name\":\"hello-mcp\"}},\"attributes\":{\"gen_ai\":{\"agent\":{\"id\":\"scripted:01a1a9b0-a441-7009-a8cb-b7a2be5f4ef9\",\"name\":\"scripted\",\"version\":\"f12cffb97ee8e0416f18570ff57f02e13beb6dbf\"},\"conversation\":{\"id\":\"01a1a9b1-3251-75db-99e3-59a54e9ca240\"},\"operation\":{\"name\":\"chat\"},\"provider\":{\"name\":\"introspection\"},\"request\":{\"model\":\"scripted-llm\",\"stream\":true},\"response\":{\"finish_reasons\":[\"stop\"],\"id\":\"chatcmpl-be00017416f3439ca95a875e2ed9ddcf\",\"model\":\"scripted-llm\",\"time_to_first_chunk\":0.008404413999999633},\"usage\":{\"input_tokens\":16,\"output_tokens\":1,\"cache_read\":{\"input_tokens\":0},\"cache_creation\":{\"input_tokens\":0}},\"tool\":{\"definitions\":[{\"name\":\"read\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"parameters\":{\"properties\":{\"limit\":{\"description\":\"Maximum number of lines to read\",\"type\":\"number\"},\"offset\":{\"description\":\"Line number to start reading from (1-indexed)\",\"type\":\"number\"},\"path\":{\"description\":\"Path to the file to read (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\",\"parameters\":{\"properties\":{\"command\":{\"description\":\"Shell command to execute\",\"type\":\"string\"},\"timeout\":{\"description\":\"Timeout in seconds (optional, no default timeout)\",\"type\":\"number\"}},\"required\":[\"command\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"write\",\"description\":\"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.\",\"parameters\":{\"properties\":{\"content\":{\"description\":\"Content to write to the file\",\"type\":\"string\"},\"path\":{\"description\":\"Path to the file to write (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\",\"content\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"mcp_hello-mcp_echo_921a5a7771\",\"description\":\"Echoes back the input\",\"parameters\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"message\":{\"description\":\"Message to echo\",\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"},\"type\":\"function\"}]},\"input\":{\"messages\":[{\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"content\":\"Reply with the single word done. <<SCRIPT {\\\"reply\\\":\\\"done\\\"}>>\"}]}]},\"output\":{\"messages\":[{\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"content\":\"done\"}],\"finish_reason\":\"stop\",\"provider\":\"introspection\",\"model\":\"scripted-llm\",\"api\":\"openai-completions\",\"response_id\":\"chatcmpl-be00017416f3439ca95a875e2ed9ddcf\"}]},\"system_instructions\":[{\"type\":\"text\",\"content\":\"Use t