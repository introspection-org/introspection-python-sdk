            "size": 749,
            "text": "{\"created_at\":\"2026-10-24T06:09:24.583176Z\",\"updated_at\":\"2026-10-24T06:09:24.583176Z\",\"org_id\":\"01a13d6d-f05f-7115-9cc9-4b168ba5d22d\",\"id\":\"01a16c87-3c66-73ec-9b69-da7d0456876d\",\"name\":\"hello-mcp\",\"description\":null,\"kind\":\"byor\",\"llm_mode\":\"managed\",\"config_json\":{},\"project_id\":\"01a16c87-2e3d-750a-b31d-ad7aefdc761e\",\"recipe_id\":\"01a16c87-3193-7009-a15d-a40ea8d3ffa7\",\"runtime_group_id\":\"01a16c87-3c66-73ec-9b69-da7edd27ef3a\",\"slug\":\"hello-mcp\",\"recipe_kind\":\"production\",\"recipe_ref\":\"main\",\"environments\":[\"staging\",\"production\"],\"image_build_status\":\"pending\",\"image_build_error_message\":null,\"image_build_metadata\":{},\"created_by_member_id\":\"01a13d6d-f063-76d5-b2f0-4fe69e032667\",\"yanked_at\":null,\"yanked_reason\":null,\"environment_ref\":null}"
