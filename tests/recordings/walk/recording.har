            "mimeType": "application/json",
            "size": 3796,
            "text": "{\"trace_id\":\"d175a657041e659aea78ae7e861f4da1\",\"span_id\":\"c94aebf5abaf9dc9\",\"parent_span_id\":\"e2ac299d18207603\",\"name\":\"chat scripted-llm\",\"kind\":\"UNSPECIFIED\",\"start_time\":\"2026-11-10T22:15:37.347000Z\",\"duration_ns\":6763581,\"status\":{\"code\":\"Unset\"},\"resource\":{\"service\":{\"name\":\"hello-mcp\"}},\"attributes\":{\"gen_ai\":{\"agent\":{\"id\":\"scripted:01a1c786-7fc0-77b6-9145-dac7574d7ebc\",\"name\":\"scripted\",\"version\":\"ba60e5d588e7a5935198bf76c5b373020d08d2d3\"},\"conversation\":{\"id\":\"01a1c787-d64d-7773-8ec1-40881f5e582d\"},\"operation\":{\"name\":\"chat\"},\"provider\":{\"name\":\"introspection\"},\"request\":{\"model\":\"scripted-llm\",\"stream\":true},\"response\":{\"finish_reasons\":[\"aborted\"],\"model\":\"scripted-llm\"},\"usage\":{\"input_tokens\":0,\"output_tokens\":0,\"cache_read\":{\"input_tokens\":0},\"cache_creation\":{\"input_tokens\":0}},\"tool\":{\"definitions\":[{\"name\":\"read\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"parameters\":{\"properties\":{\"limit\":{\"description\":\"Maximum number of lines to read\",\"type\":\"number\"},\"offset\":{\"description\":\"Line number to start reading from (1-indexed)\",\"type\":\"number\"},\"path\":{\"description\":\"Path to the file to read (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\",\"parameters\":{\"properties\":{\"command\":{\"description\":\"Shell command to execute\",\"type\":\"string\"},\"timeout\":{\"description\":\"Timeout in seconds (optional, no default timeout)\",\"type\":\"number\"}},\"required\":[\"command\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"write\",\"description\":\"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.\",\"parameters\":{\"properties\":{\"content\":{\"description\":\"Content to write to the file\",\"type\":\"string\"},\"path\":{\"description\":\"Path to the file to write (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\",\"content\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"mcp_hello-mcp_echo_921a5a7771\",\"description\":\"Echoes back the input\",\"parameters\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"message\":{\"description\":\"Message to echo\",\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"},\"type\":\"function\"}]},\"output\":{\"messages\":[{\"role\":\"assistant\",\"finish_reason\":\"aborted\",\"provider\":\"introspection\",\"model\":\"scripted-llm\",\"api\":\"openai-completions\"}]}},\"introspection\":{\"agent\":{\"depth\":\"0\",\"kind\":\"session\"},\"byok\":false,\"environment\":\"production\",\"ingest\":{\"host\":\"e9e62208f066\",\"time\":1794348937363702},\"member\":{\"id\":\"01a1c786-50ff-70c0-bebc-bb78a49b9e47\"},\"org\":{\"id\":\"01a1c786-50eb-7375-93d2-7a1275fb1856\"},\"project\":{\"id\":\"01a1c786-6d34-7346-b293-ea2d5cef127c\"},\"recipe\":{\"git_commit_sha\":\"ba60e5d588e7a5935198bf76c5b373020d08d2d3\"},\"run\":{\"id\":\"01a1c787-f030-745d-9cde-6d8cec631475\",\"root_id\":\"01a1c787-d64d-7773-8ec1-4087da97137b\"},\"runtime\":{\"group_id\":\"01a1c786-7fc0-77b6-9145-dac7574d7ebc\",\"id\":\"01a1c787-aa1c-70b7-9de4-9ca95bff0a68\"},\"task\":{\"id\":\"01a1c787-d64d-7773-8ec1-40881f5e582d\",\"run_id\":\"01a1c787-f03