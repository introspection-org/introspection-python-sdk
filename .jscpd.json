{
  "path": ["introspection_sdk"],
  "pattern": "**/*.py",
  "format": ["python"],
  "ignore": ["**/.venv/**", "**/__pycache__/**", "**/*_pb2.py"],
  "gitignore": true,
  "minTokens": 50,
  "minLines": 5,
  "mode": "weak",
  "kind": ["exact", "renamed"],
  "ignoreIdentifiers": true,
  "threshold": 29.3,
  "reporters": ["console"]
}
