{
  "path": [
    "introspection_aauth"
  ],
  "pattern": "**/*.py",
  "format": [
    "python"
  ],
  "ignore": [
    "**/.venv/**",
    "**/__pycache__/**"
  ],
  "gitignore": true,
  "minTokens": 50,
  "minLines": 5,
  "mode": "weak",
  "kind": [
    "exact",
    "renamed"
  ],
  "ignoreIdentifiers": true,
  "threshold": 0,
  "reporters": [
    "console"
  ],
  "ignorePattern": [
    "from [\\w.]+ import \\([^)]*\\)",
    "from [\\w.]+ import [^\\n(]+",
    "import [\\w.]+( as \\w+)?"
  ]
}
